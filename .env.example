# Meteor REST base (no trailing slash issues — include /api/v1)
# Emulator / iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Live chat WebSocket (Meteor DDP). Optional — derived from EXPO_PUBLIC_API_URL as
# ws(s)://<host>/websocket when unset. Android localhost is rewritten to 10.0.2.2.
# EXPO_PUBLIC_API_DDP_URL=ws://localhost:4000/websocket

# Android emulator: localhost is rewritten to 10.0.2.2 in the app (dev builds + cleartext OK).
# Physical Android device: use your machine LAN IP, then restart Metro (`npm run start:dev-client`).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1

# Production / TestFlight (HTTPS — Namecheap A record + mup proxy)
# Set the same values in EAS → Environments → production (and preview if needed).
# EXPO_PUBLIC_API_URL=https://api.beru.digital/api/v1
# EXPO_PUBLIC_API_DDP_URL=wss://api.beru.digital/websocket
# EXPO_PUBLIC_PRIVACY_URL=https://your-app.vercel.app/privacy
# EXPO_PUBLIC_TERMS_URL=https://your-app.vercel.app/terms
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
