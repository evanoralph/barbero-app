# Meteor REST base (no trailing slash issues — include /api/v1)
# Emulator / iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Android emulator: localhost is rewritten to 10.0.2.2 in the app (dev builds + cleartext OK).
# Physical Android device: use your machine LAN IP, then restart Metro (`npm run start:dev-client`).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1

# Google Maps API keys — required for store/production builds that use Google Maps.
# Expo Go works without these (Apple Maps on iOS; bundled Google Maps on Android).
# Copy values into app.json → plugins → react-native-maps when building with EAS.
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
