    "simpleddp-plugin-login": "^4.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "android:run": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:build:eas": "eas build --profile development --platform android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bash scripts/e2e/run.sh",
    "test:e2e:ios": "bash scripts/e2e/run.sh --platform ios",
    "test:e2e:android": "bash scripts/e2e/run.sh --platform android",
    "test:e2e:smoke": "bash scripts/e2e/run.sh --suite smoke",
    "test:e2e:full": "bash scripts/e2e/run.sh --suite full",
    "eas:ci": "eas workflow:run .eas/workflows/ci.yml",
    "eas:preview": "eas workflow:run .eas/workflows/preview.yml",
    "eas:preview:main": "eas workflow:run .eas/workflows/android-preview-main.yml",
    "eas:production": "eas workflow:run .eas/workflows/production.yml",
    "eas:testflight": "eas workflow:run .eas/workflows/testflight.yml",
    "eas:ios:credentials": "eas credentials -p ios",
    "eas:ios:production": "eas build --profile production --platform ios",
    "eas:ios:submit": "eas submit --platform ios --profile production --latest"
  },
  "private": true
}
